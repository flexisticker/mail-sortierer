<?xml version="1.0"?>
<Container version="2">
  <Name>Mail-Sortierer</Name>
  <Repository>ghcr.io/flexisticker/mail-sortierer:latest</Repository>
  <Registry>https://github.com/flexisticker/mail-sortierer/pkgs/container/mail-sortierer</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Support>https://github.com/flexisticker/mail-sortierer</Support>
  <Project>https://github.com/flexisticker/mail-sortierer</Project>
  <Overview>Sortiert das IMAP-Postfach mit der lokalen KI (Ollama) in Ordner und lernt aus Korrekturen. Nichts verlässt das Heimnetz. Löscht nie.</Overview>
  <Category>Productivity: Tools:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <Icon>http://192.168.1.10:8110/icon.png</Icon>
  <ExtraParams>--restart unless-stopped</ExtraParams>
  <Config Name="Oberfläche" Target="8080" Default="8110" Mode="tcp" Description="Weboberfläche. NUR im Heimnetz verwenden, nicht über den Proxy nach außen freigeben." Type="Port" Display="always" Required="true" Mask="false">8110</Config>
  <Config Name="Daten" Target="/data" Default="/mnt/user/appdata/mail-sortierer" Mode="rw" Description="Datenbank, Einstellungen, Schlüssel (mitsichern)" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/mail-sortierer</Config>
  <Config Name="Zeitzone" Target="TZ" Default="Europe/Berlin" Mode="" Description="Zeitzone" Type="Variable" Display="advanced" Required="false" Mask="false">Europe/Berlin</Config>
</Container>
